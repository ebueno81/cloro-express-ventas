            <TablixRow>
              <Height>0.48in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TxtResumenContrato">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>="RESUMEN DEL CONTRATO     Facturado: " &amp; First(Fields!Moneda.Value, "grpContrato") &amp; " " &amp; Format(Sum(IIF(Fields!Estado.Value = "FACTURADO", CDbl(Fields!Monto.Value), CDbl(0)), "grpContrato"), "N2") &amp; "     Pendiente: " &amp; First(Fields!Moneda.Value, "grpContrato") &amp; " " &amp; Format(Sum(IIF(Fields!Estado.Value &lt;&gt; "FACTURADO", CDbl(Fields!Monto.Value), CDbl(0)), "grpContrato"), "N2") &amp; "     Total: " &amp; First(Fields!Moneda.Value, "grpContrato") &amp; " " &amp; Format(Sum(CDbl(Fields!Monto.Value), "grpContrato"), "N2")</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8.5pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <Color>#245882</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style>
                            <TextAlign>Right</TextAlign>
                          </Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border>
                          <Color>#aabbc8</Color>
                          <Style>Solid</Style>
                        </Border>
                        <BackgroundColor>#eef3f6</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>5pt</PaddingLeft>
                        <PaddingRight>8pt</PaddingRight>
                      </Style>
                    </Textbox>
                    <ColSpan>6</ColSpan>
                  </CellContents>
                </TablixCell>
