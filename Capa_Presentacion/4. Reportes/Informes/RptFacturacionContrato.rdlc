                    <Textbox Name="DPeriodo">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Format(Fields!PeriodoDesde.Value, "dd/MM/yy") &amp; " - " &amp; Format(Fields!PeriodoHasta.Value, "dd/MM/yy")</Value>
