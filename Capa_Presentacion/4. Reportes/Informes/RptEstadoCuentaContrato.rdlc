                  <CellContents>
                    <Textbox Name="DOT">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=IIF(Fields!NroOT.Value = Nothing OR Fields!NroOT.Value = "", "", Fields!SerieOT.Value &amp; "-" &amp; Fields!NroOT.Value)</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>#222222</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
